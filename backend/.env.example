PORT=3002
FRONTEND_URL=http://localhost:3003
GAME_API_URL=http://127.0.0.1:3001/api
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optionally reuse the neighboring game's server configuration without copying keys.
GAME_ENV_FILE=../../PokemonzApp/backend-gameplay/api/.env
# Local development only; binds to loopback and checks the requesting origin.
DASHBOARD_LOCAL_MODE=true
# Shared login code; set this only in backend/.env and never in the frontend.
DASHBOARD_ACCESS_CODE= 123456
